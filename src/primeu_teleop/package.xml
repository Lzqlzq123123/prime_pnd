<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>primeu_teleop</name>
  <version>0.1.0</version>
  <description>PrimeU humanoid upper-body teleoperation using libsurvive Lighthouse trackers and Mink IK solver.</description>
  <maintainer email="lzq@example.com">lzq</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>std_msgs</depend>
  <!-- primeu_description is used at runtime for the MuJoCo model; kept as
       exec_depend so primeu_teleop can build even when primeu_description
       is skipped (e.g. xacro not installed). -->
  <exec_depend>primeu_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
